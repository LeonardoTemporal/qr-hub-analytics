# URL de base de datos PostgreSQL (Docker Compose)
DATABASE_URL=postgresql+asyncpg://qrhub:qrhub_secret@postgres:5432/qrhub

# URL del frontend Vite/Nginx (para redirects)
# Producción: https://7fitment.com
FRONTEND_URL=https://7fitment.com

# Geolocalizacion IP backend para estado/municipio.
GEOIP_API_URL=http://ip-api.com/json
GEOIP_TIMEOUT_SECONDS=1.5

# Credenciales del dashboard admin (POST /api/auth/login + Basic Auth en /api/analytics/*)
# IMPORTANTE: cambiar en producción a valores seguros y nunca commitear el .env real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=7fitment2026
