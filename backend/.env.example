# URL de base de datos PostgreSQL (Docker Compose)
DATABASE_URL=postgresql+asyncpg://qrhub:qrhub_secret@postgres:5432/qrhub

# URL del frontend Vite/Nginx (para redirects)
# Producción: https://7fitment.com
FRONTEND_URL=https://7fitment.com

# Geolocalizacion IP backend para estado/municipio.
GEOIP_API_URL=http://ip-api.com/json
GEOIP_TIMEOUT_SECONDS=2.5

# Compatibilidad heredada deshabilitada. La cuenta administrativa se crea con
# `python -m app.cli create-admin` y la contrasena solo se guarda hasheada.
ADMIN_USERNAME=
ADMIN_PASSWORD=
PORTAL_TOKEN_SECRET=replace_with_a_long_random_secret
PORTAL_TOKEN_TTL_SECONDS=1800
MEDIA_TOKEN_TTL_SECONDS=1800
