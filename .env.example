# Root-level .env template
# Copy this file to .env and populate every variable before running docker compose.
# Do NOT commit .env to version control.

# --- PostgreSQL ---
POSTGRES_USER=qrhub
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=qrhub

# --- Backend ---
# Internal URL used by the backend to build redirect targets.
FRONTEND_URL=http://localhost:3000
GEOIP_API_URL=https://ipwho.is
GEOIP_TIMEOUT_SECONDS=2.5
QR_RATE_LIMIT_PER_MINUTE=120
BROWSER_LOCATION_RATE_LIMIT_PER_MINUTE=4
TRACKING_EVENT_RATE_LIMIT_PER_MINUTE=20
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Localhost uses HTTP. Production must set this to true.
QR_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=true
INTERNAL_PROXY_SECRET=replace_with_a_distinct_long_random_secret
TRACKING_ANALYTICS_CAMPAIGNS=qr_general
TRACKING_WHATSAPP_URL=https://wa.me/5215637940104?text=Hola%207Fitment%2C%20quiero%20cotizar%20un%20proyecto%20para%20mi%20auto
TRACKING_INSTAGRAM_URL=https://www.instagram.com/7fitment/

# --- Frontend ---
# Publicly reachable backend URL. Embedded at Vite build time.
# Empty uses the same origin through Nginx. Vite dev uses VITE_API_PROXY_TARGET.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_DEFAULT_CAMPAIGN_ID=qr_general
VITE_PUBLIC_SITE_URL=https://7fitment.com

# --- Admin Dashboard ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
PORTAL_TOKEN_SECRET=replace_with_a_long_random_secret
PORTAL_TOKEN_TTL_SECONDS=1800
MEDIA_TOKEN_TTL_SECONDS=1800

# --- CORS ---
# Comma-separated origins for local Vite, preview and production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://7fitment.com,https://www.7fitment.com,https://admin.7fitment.com

# --- Modular platform ---
ADMIN_COOKIE_SECURE=true
COOKIE_DOMAIN=
MEDIA_MAX_UPLOAD_MB=250
RAW_ANALYTICS_RETENTION_DAYS=365
N8N_WEBHOOK_URL=
# Prebuilt backend image used by production. For local image builds, include
# docker-compose.build.yml as a second Compose file.
QRHUB_BACKEND_IMAGE=ghcr.io/leonardotemporal/qrhub-backend:main
